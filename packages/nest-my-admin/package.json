{
  "name": "nest-my-admin",
  "version": "0.10.3",
  "description": "An admin panel for NestJS + TypeORM in the spirit of Django admin: lists, forms, roles, audit log and a prebuilt UI, served by your own app",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/phantomboy0/nest-my-admin.git", "directory": "packages/nest-my-admin" },
  "homepage": "https://github.com/phantomboy0/nest-my-admin#readme",
  "bugs": "https://github.com/phantomboy0/nest-my-admin/issues",
  "keywords": ["nestjs", "nest", "typeorm", "admin", "admin-panel", "django-admin", "backoffice", "crud", "dashboard", "rbac", "audit-log", "rtl"],
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js",
      "default": "./index.js"
    },
    "./auth": {
      "types": "./auth.d.ts",
      "import": "./auth.js",
      "default": "./auth.js"
    },
    "./testing": {
      "types": "./testing.d.ts",
      "import": "./testing.js",
      "default": "./testing.js"
    },
    "./package.json": "./package.json"
  },
  "files": ["index.js", "index.d.ts", "auth.js", "auth.d.ts", "testing.js", "testing.d.ts"],
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "prepack": "cp ../../README.md ../../LICENSE .",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@nest-my-admin/auth": "workspace:*",
    "@nest-my-admin/core": "workspace:*",
    "@nest-my-admin/testing": "workspace:*"
  }
}
